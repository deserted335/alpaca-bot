FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates git bash && rm -rf /var/lib/apt/lists/*
RUN useradd --create-home --uid 10001 claude
USER claude
ENV HOME=/home/claude PATH=/home/claude/.local/bin:$PATH
RUN curl -fsSL https://claude.ai/install.sh | bash
WORKDIR /workspace
ENTRYPOINT ["claude"]
